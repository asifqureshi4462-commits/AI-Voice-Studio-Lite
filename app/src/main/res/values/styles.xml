<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.AIVoiceStudio" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_violet</item>
        <item name="colorPrimaryVariant">@color/primary_violet_dark</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/bg_dark_void</item>
        <item name="android:navigationBarColor">@color/bg_dark_void</item>
        <item name="android:windowBackground">@color/bg_dark_void</item>
        <item name="materialCardViewStyle">@style/Widget.AIVoiceStudio.Card</item>
        <item name="materialButtonStyle">@style/Widget.AIVoiceStudio.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.AIVoiceStudio.Button.Outline</item>
        <item name="sliderStyle">@style/Widget.AIVoiceStudio.Slider</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Card style applied app-wide: subtle border + soft elevation + ripple -->
    <style name="Widget.AIVoiceStudio.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card_glass</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/stroke_glass</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_violet</item>
    </style>

    <!-- Primary filled button applied app-wide -->
    <style name="Widget.AIVoiceStudio.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- Outlined button applied app-wide -->
    <style name="Widget.AIVoiceStudio.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/stroke_glass</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">@color/ripple_violet</item>
    </style>

    <style name="Widget.AIVoiceStudio.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">4dp</item>
        
    </style>
<!-- Base text appearance -->
<style name="TextAppearance.AIVoiceStudio" parent="TextAppearance.Material3.BodyLarge">
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textSize">14sp</item>
</style>
    
    <!-- Text appearances -->
    <style name="TextAppearance.AIVoiceStudio.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.AIVoiceStudio.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AIVoiceStudio.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.AIVoiceStudio.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
